<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EcommerceViewportMatrixSuite" parallel="tests" thread-count="4">

    <listeners>
        <listener class-name="com.rishabh.framework.listeners.TestListener"/>
        <listener class-name="com.rishabh.framework.listeners.RetryListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
    </listeners>

    <!-- same smoke-tagged classes, launched at four different screen resolutions via
         BaseTest's viewportWidth/viewportHeight suite parameters -->
    <test name="Desktop-1920x1080">
        <parameter name="browser" value="chrome"/>
        <parameter name="viewportWidth" value="1920"/>
        <parameter name="viewportHeight" value="1080"/>
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.rishabh.tests.regression.HomeNavigationTests"/>
            <class name="com.rishabh.tests.regression.ProductListingFilterTests"/>
            <class name="com.rishabh.tests.regression.CartTests"/>
        </classes>
    </test>

    <test name="Laptop-1366x768">
        <parameter name="browser" value="chrome"/>
        <parameter name="viewportWidth" value="1366"/>
        <parameter name="viewportHeight" value="768"/>
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.rishabh.tests.regression.HomeNavigationTests"/>
            <class name="com.rishabh.tests.regression.ProductListingFilterTests"/>
            <class name="com.rishabh.tests.regression.CartTests"/>
        </classes>
    </test>

    <test name="Tablet-768x1024">
        <parameter name="browser" value="chrome"/>
        <parameter name="viewportWidth" value="768"/>
        <parameter name="viewportHeight" value="1024"/>
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.rishabh.tests.regression.HomeNavigationTests"/>
            <class name="com.rishabh.tests.regression.ProductListingFilterTests"/>
            <class name="com.rishabh.tests.regression.CartTests"/>
        </classes>
    </test>

    <test name="Mobile-375x667">
        <parameter name="browser" value="chrome"/>
        <parameter name="viewportWidth" value="375"/>
        <parameter name="viewportHeight" value="667"/>
        <groups><run><include name="smoke"/></run></groups>
        <classes>
            <class name="com.rishabh.tests.regression.HomeNavigationTests"/>
            <class name="com.rishabh.tests.regression.ProductListingFilterTests"/>
            <class name="com.rishabh.tests.regression.CartTests"/>
        </classes>
    </test>

</suite>
